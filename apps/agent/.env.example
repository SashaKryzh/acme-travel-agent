# Copy to apps/agent/.env.local.

# The model, and OpenAI's web search: an OpenAI API key.
OPENAI_API_KEY=

# Optional: live hotels from LiteAPI. Without it the agent books on the demo world.
NUITEE_API_KEY=

# Optional: one shared team password for the deployed site. Unset locally, so localhost stays open.
# SITE_PASSWORD=
