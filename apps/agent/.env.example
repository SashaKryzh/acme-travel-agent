# Copy to apps/agent/.env.local.

# The model, through the Vercel AI Gateway: https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: use OpenAI directly instead of the gateway. Set all three together.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=gpt-6.1-sol

# Optional: live hotels (LiteAPI) and web research (Exa). Without both keys the agent uses the demo world.
NUITEE_API_KEY=
EXA_API_KEY=
