# Copy to .env.local. Both `eve dev` (repo root) and the web app read it.

# Model. A Vercel AI Gateway model id; eve routes it through the gateway with AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5.5

# Optional: any OpenAI-compatible Chat Completions server instead of the gateway (OpenAI, OpenRouter, vLLM,
# Ollama, LiteLLM...). When the base URL is set, AGENT_MODEL is that server's model name.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Context window of that model, so eve knows when to compact. Defaults to 200000.
AGENT_CONTEXT_WINDOW_TOKENS=

# Live hotels (LiteAPI by Nuitee; a sandbox key books test stays for free) and live web research (Exa).
# Without both keys the agent runs in demo mode on the mocked world. ACME_DEMO=1 forces demo mode, ACME_DEMO=0 live.
NUITEE_API_KEY=
EXA_API_KEY=
ACME_DEMO=

# Optional: the fictional ACME account the agent serves (defaults to Sam Rivera in Tallinn).
ACME_USER_NAME=
ACME_USER_EMAIL=
ACME_HOME_CITY=
ACME_COUNTRY_CODE=
ACME_CURRENCY=
ACME_LANGUAGE=
ACME_TIME_ZONE=

# Optional: where the eve server runs, for the web app's /eve/v1 proxy. Defaults to http://127.0.0.1:3200.
EVE_AGENT_URL=
